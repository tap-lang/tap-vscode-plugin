{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "tap",
    "scopeName": "source.tap",
    "patterns": [
        {
            "include": "#test-block"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "test-block": {
            "name": "comment.block.test.tap",
            "begin": "/\\*+[ \\t]*--[ \\t]*test\\b",
            "end": "--[ \\t]*\\*/|\\*/",
            "beginCaptures": {
                "0": {
                    "name": "comment.block.test.header.tap"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "comment.block.test.header.tap"
                }
            },
            "patterns": [
                {
                    "include": "#test-expectation"
                }
            ]
        },
        "test-expectation": {
            "begin": "(^[ \\t]*-[ \\t]*)(?:(\\.stdout)|(\\.stderr)|(\\.exit))(?=[ \\t]*$)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.list.begin.tap"
                },
                "2": {
                    "name": "markup.inserted.test-expectation.tap"
                },
                "3": {
                    "name": "invalid.test-expectation.tap"
                },
                "4": {
                    "name": "markup.inserted.test-expectation.tap"
                }
            },
            "end": "(?=^[ \\t]*-[ \\t]*\\.)|(?=--[ \\t]*\\*/)",
            "contentName": "string.unquoted.test-expectation.tap"
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.tap",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.tap",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.tap",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.tap",
                    "match": "\\\\([\\\\\"nrt0]|x[0-9A-Fa-f]{2}|.)"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.tap",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.tap",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.tap"
                        },
                        "2": {
                            "name": "entity.name.function.definition.tap"
                        }
                    }
                },
                {
                    "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.tap"
                        },
                        "2": {
                            "name": "entity.name.type.tap"
                        }
                    }
                },
                {
                    "match": "(:[ \\t]*)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.tap"
                        },
                        "2": {
                            "name": "storage.type.tap"
                        }
                    }
                },
                {
                    "match": "\\b([A-Z][A-Za-z0-9_]*)[ \\t]*(?=\\{)",
                    "captures": {
                        "1": {
                            "name": "storage.type.tap"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.tap",
                    "match": "\\b(if|elseif|else|for|while|break|continue|return|match)\\b"
                },
                {
                    "name": "keyword.declaration.tap",
                    "match": "\\b(fn|let|const|struct|enum|extern|import|as)\\b"
                },
                {
                    "name": "keyword.other.tap",
                    "match": "\\b(sizeof)\\b"
                },
                {
                    "name": "support.function.builtin.tap",
                    "match": "\\b(print|min|max|abs|square)\\b"
                },
                {
                    "name": "constant.language.boolean.tap",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "name": "storage.type.tap",
            "match": "\\b(int|uint|i8|u8|i16|u16|i32|u32|i64|u64|i128|u128|float|f32|f64|bool|string|array)\\b"
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.call.tap",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "name": "keyword.operator.tap",
            "match": "(=>|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|[+\\-*/%!<>&=.:;,])"
        }
    }
}
