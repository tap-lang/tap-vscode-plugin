{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "4yue",
    "scopeName": "source.4yue",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.4yue",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.4yue",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.4yue",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.4yue",
                    "match": "\\\\([\\\\\"nrt0]|x[0-9A-Fa-f]{2}|.)"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.4yue",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.4yue",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.4yue",
                    "match": "\\b(if|elseif|else|for|break|continue|return)\\b"
                },
                {
                    "name": "keyword.declaration.4yue",
                    "match": "\\b(fn|let|import|as)\\b"
                },
                {
                    "name": "support.function.builtin.4yue",
                    "match": "\\b(print|min|max|abs|square)\\b"
                },
                {
                    "name": "constant.language.boolean.4yue",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "name": "storage.type.4yue",
            "match": "\\b(int|uint|i8|u8|i16|u16|i32|u32|i64|u64|i128|u128|float|f32|f64|bool|string|array)\\b"
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.definition.4yue"
                        }
                    }
                },
                {
                    "name": "support.function.call.4yue",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "name": "keyword.operator.4yue",
            "match": "(==|!=|<=|>=|&&|\\|\\||\\+\\+|--|[+\\-*/=<>:.,;])"
        }
    }
}
